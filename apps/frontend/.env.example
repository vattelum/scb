# Live Sepolia demo deployment. Copy this file to .env to run the app against the
# pre-deployed demo. To use your own deployment, replace every address below with
# your contract's address (the deploy scripts in apps/contracts print them to the
# console; you can also read them from apps/contracts/.env after deployment).

# DAA core
# Membership token that gates who can create contracts. Printed by 01_Deploy.s.sol ("DAAToken deployed at:").
VITE_DAA_TOKEN_ADDRESS=0xA4efD6dcAcc89F286eB40f88B8F6c4715757f805
# Address of the registry holding your legislation and contract templates. Printed by 01_Deploy.s.sol ("DAARegistry deployed at:").
VITE_DAA_REGISTRY_ADDRESS=0xA1cc629EC7DcEE1b7Ba89D0Ee16dfeC76d3069D0

# Governance
# The Safe that owns the registry after deployment, plus the Snapshot X space and the voting strategies.
# Safe — from 02_DeploySafe.s.sol (read from the deploy transaction receipt).
VITE_SAFE_ADDRESS=0x2ffc0fC19960B522fAf9455c57B172628FdfC3bB
# Snapshot X space — from 03_CreateVotingSpace.s.sol (read from the transaction receipt / event logs).
VITE_SX_SPACE_ADDRESS=0x7f203944dc55f8ea48169e5dfc4496c1eadd4527
# Standard-quorum + supermajority voting strategies — both printed by 04_DeployVotingStrategies.s.sol.
VITE_NORMAL_STRATEGY_ADDRESS=0x6398f8759be2762f09a6c51678a12b9522ed9aa7
VITE_CORE_STRATEGY_ADDRESS=0x4a5210d518b1866b82c66431b76e2d20d8dc6670

# Snapshot X EthTxAuthenticator (per-chain; this is the Sepolia address)
VITE_AUTHENTICATOR_ADDRESS=0xBA06E6cCb877C332181A6867c05c8b746A21Aed1

# Network
# Chain id of the blockchain everything is deployed on, the block to start event scans from (set to the
# registry's deploy block); and a RPC for that chain to read data from the blockchain.
VITE_CHAIN_ID=11155111
VITE_DEPLOY_BLOCK=10844013
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Smart Contract Block
# Contract registry — printed by 08_DeployContractRegistry.s.sol ("ContractRegistry deployed at:").
VITE_CONTRACT_REGISTRY_ADDRESS=0x05F3d260BF4E5BF7033999d26C138784729117b7
# Per-wallet encryption-key registry (ECIES) — printed by 09_DeployPubkeyRegistry.s.sol ("PubkeyRegistry deployed at:").
VITE_PUBKEY_REGISTRY_ADDRESS=0x8c1a70ae071ac24ed0446c9e71f07278a79f0a2a
# The category id that holds your contract templates that will be loaded on the /contract page.
# Category ids are assigned at creation (see apps/contracts/script/01_Deploy.s.sol)
VITE_CONTRACT_TEMPLATE_CATEGORY_ID=3

# Terms of membership (DAARegistry pointer; both must be set together — leave blank to disable)
VITE_TERMS_CATEGORY_ID=
VITE_TERMS_DOCUMENT_ID=

# Arweave uploads use the connected wallet via ArDrive Turbo — no key needed.
