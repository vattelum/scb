# Deploy script configuration. Copy this file to .env before deploying.
# The addresses below are the live Sepolia demo deployment — REPLACE each one with
# your own contract address as the numbered scripts in script/ deploy them.

# RPC endpoint for the network you are deploying to (must change for mainnet)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Signing — REPLACE with your own deployer key.
# WARNING: storing private keys in plaintext files is a security risk. Use this
# for testnet only. For mainnet, prefer a hardware wallet, an encrypted keystore,
# or pass the key via --interactive at runtime.
PRIVATE_KEY=0x...

# Safer alternatives (pass directly to forge instead):
#   forge script script/01_Deploy.s.sol --ledger          (hardware wallet)
#   forge script script/01_Deploy.s.sol --trezor          (hardware wallet)
#   forge script script/01_Deploy.s.sol --account mykey   (encrypted keystore via cast wallet)
#   forge script script/01_Deploy.s.sol --interactive     (prompts for private key at runtime)

# DAA core (set by 01_Deploy.s.sol)
DAATOKEN_ADDRESS=0xA4efD6dcAcc89F286eB40f88B8F6c4715757f805
DAAREGISTRY_ADDRESS=0xA1cc629EC7DcEE1b7Ba89D0Ee16dfeC76d3069D0

# Governance (set by 02 / 03 / 04)
SAFE_ADDRESS=0x2ffc0fC19960B522fAf9455c57B172628FdfC3bB
SX_SPACE_ADDRESS=0x7f203944dc55f8ea48169e5dfc4496c1eadd4527
NORMAL_STRATEGY_ADDRESS=0x6398f8759be2762f09a6c51678a12b9522ed9aa7
CORE_STRATEGY_ADDRESS=0x4a5210d518b1866b82c66431b76e2d20d8dc6670

# Smart Contract Block (set by 08 / 09)
CONTRACT_REGISTRY_ADDRESS=0x768CCf08730078dbAFBA9bB20b0CA015F649637F
PUBKEY_REGISTRY_ADDRESS=0x8c1a70ae071ac24ed0446c9e71f07278a79f0a2a
CONTRACT_TEMPLATE_CATEGORY_ID=3

# Etherscan (for contract verification)
ETHERSCAN_API_KEY=
